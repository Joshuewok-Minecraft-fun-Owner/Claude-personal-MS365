{
  "name": "personal-m365-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [{ "new_sqlite_classes": ["MicrosoftMCP"], "tag": "v1" }],
  "durable_objects": {
    "bindings": [{ "class_name": "MicrosoftMCP", "name": "MCP_OBJECT" }]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_ID" }],
  "observability": { "enabled": true }
}
